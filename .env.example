# Copy to .env.local for local development. On GitHub, add these as
# repository secrets / variables (Settings → Secrets and variables → Actions).

# Required: Notion internal integration secret (notion.so/my-integrations).
# The integration must be connected to the "Portfolio Website Content" page.
NOTION_TOKEN=

# Public URL of the site, used for canonical links, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: endpoint the Connect form POSTs to (JSON: name, email, message).
# Works with Formspree (https://formspree.io/f/xxxx), Web3Forms, Getform, etc.
# Leave empty and the form opens a pre-filled email instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: override Notion data source IDs if you duplicate the databases.
# NOTION_PROFILE_DS=
# NOTION_PROJECTS_DS=
# NOTION_WORK_DS=
# NOTION_SOCIALS_DS=
